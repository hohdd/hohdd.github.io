	"Sequence Diagrams Template": {
	  "prefix": "dhsequenceDiagram",
	  "body": [
		"<!--Sequence Diagrams content-->",
		"<!-- REF:https://mermaid.js.org/syntax/sequenceDiagram.html -->",
		"<!-- Người tham gia: participant Alice, actor Alice, participant A as Alice  -->",
		"<!-- Luồng và Tin nhắn: [Actor][Arrow][Actor]:Message text, Ví dụ: Alice->>Bob: Hello Bob, how are you ?  -->",
		"<!-- Các loại luồng: LIỀN:-, CHẤM:--, Xác định mũi tên: KHÔNG:>, CÓ:>>, DEL:x -->",
		"<!-- Group/Box: box COLOR NAME ... end, với COLOR = Aqua, Purple, transparent, rgb(33,66,99), rgba(33,66,99,0.5) -->",
		"<!-- Activate: activate [Actor], ví dụ: activate John (có thể thêm hậu tố '+' ngay sau mũi tên thay cho 'active')  -->",
		"<!-- Deactivate: deactivate [Actor], ví dụ: deactivate John (có thể thêm hậu tố '-' ngay sau mũi tên thay cho 'deactivate')  -->",
		"<!-- Xếp chồng Activate: có thể xếp chồng nhiều Activate theo luồng tuần tự -->",
		"<!-- Ghi chú: Note [ right of | left of | over ] [Actor]: note content, có thể 'Note over [Actor1],[Actor2]' ví dụ: Note over Alice,John -->",
		"<!-- Xuống dòng: có thể thêm ngắt dòng vào Ghi chú và Tin nhắn với <br/>  -->",
		"<!-- Vòng lặp: loop TITLE ... end  -->",
		"<!-- Kiểu Alt (if-else-option): alt TITLE ... else TITLE ... end opt TITLE ... end  -->",
		"<!-- Hành động diễn ra Song song: par TITLE ... and TITLE ... and TITLE ... end, Có thể LỒNG NHAU Hành động diễn ra Song song -->",
		"<!-- Khu vực quan trọng: critical TITLE ... option TITLE ... option TITLE ... end -->",
		"<!-- Phá vỡ: break TITLE ... end (thường được sử dụng để mô hình hóa các trường hợp ngoại lệ) -->",
		"<!-- Làm nổi bật nền/khu vực: rect COLOR ... end, với COLOR = rgb(0, 255, 0), rgba(0, 0, 255, .1) -->",
		"<!-- Chuỗi số: Có thể lấy số thứ tự được gắn vào mỗi mũi tên trong sơ đồ, JAVASCRIPT: mermaid.initialize({ sequence: { showSequenceNumbers: true } }); -->",
		"<!-- Actor Menu (link): Có thể có các menu bật lên chứa các liên kết khi click vào Actor: link <actor>: <link-label> @ <link-url> -->",
