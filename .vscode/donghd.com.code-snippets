		"<pre class='mermaid' >",
		"sequenceDiagram",
		"  %% bình luận bắt đầu với 2 dấu %",
		"  Alice->>John: Hello John, how are you?",
		"  John-->>Alice: Great!",
		"  Alice-)John: See you later!",
		"  links Alice: {\"About\": \"#about\", \"Services\": \"#services\"}",
		"  links John: {\"About\": \"#about\", \"Services\": \"#services\"}",
		"</pre>",
	  ],
